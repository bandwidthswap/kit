[Unit]
Description=bwkit: post the ledger's public summary to the status page
After=network-online.target bwkit.service
Wants=network-online.target
# The URL and the token live in a root-only file; without it this is a no-op.
ConditionPathExists=/etc/bwkit/status.env

[Service]
Type=oneshot
User=bwkit
Group=bwkit
EnvironmentFile=/etc/bwkit/status.env
ExecStart=/usr/local/bin/bwkit report
Environment=PYTHONUNBUFFERED=1
