[Unit]
Description=bwkit: post the ledger's public summary, signed, to the status feed
After=network-online.target bwkit.service
Wants=network-online.target

[Service]
Type=oneshot
User=bwkit
Group=bwkit
# Where it posts is `status_url` in /etc/bwkit/config.json; without one this logs a line and exits 0.
ExecStart=/usr/local/bin/bwkit report
Environment=PYTHONUNBUFFERED=1
